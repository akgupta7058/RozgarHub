rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidWorker(data) {
      return data.keys().hasAll(['name', 'category', 'dailyRate', 'experienceYears', 'phone', 'city', 'area', 'description', 'status'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.category is string
        && data.dailyRate is number && data.dailyRate >= 100 && data.dailyRate <= 50000
        && data.experienceYears is number && data.experienceYears >= 0 && data.experienceYears <= 60
        && data.phone is string && data.phone.size() == 10
        && data.city is string && data.city.size() >= 2 && data.city.size() <= 60
        && data.area is string && data.area.size() >= 2 && data.area.size() <= 100
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 1000
        && data.status is string && data.status in ['pending', 'approved', 'blocked'];
    }

    // Workers collection: Public discovery and zero-friction worker registration with Admin controls
    match /workers/{workerId} {
      allow read: if true;
      allow create: if isValidId(workerId) && isValidWorker(incoming());
      allow update: if isValidId(workerId);
      allow delete: if isValidId(workerId);
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
