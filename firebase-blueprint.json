{
  "entities": {
    "Worker": {
      "title": "Worker",
      "description": "Registered blue-collar worker profile on RozgarHub with anti-fake verification",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Full name of worker (Apna Poora Naam)",
          "minLength": 2,
          "maxLength": 100
        },
        "category": {
          "type": "string",
          "description": "Work category from strict 12 trades",
          "enum": [
            "Rajmistri",
            "Labour / Majdoor",
            "Thekedar",
            "Tile & Marble Mistri",
            "Plumber",
            "Electrician",
            "Painter / POP",
            "Carpenter (Badhai)",
            "Welder (Lohe ka Kaam)",
            "Glass & Aluminium Work",
            "Boring & Submersible Mistri",
            "AC & Cooler Mistri"
          ]
        },
        "dailyRate": {
          "type": "number",
          "description": "Daily wage rate in Indian Rupees"
        },
        "experienceYears": {
          "type": "number",
          "description": "Years of experience"
        },
        "phone": {
          "type": "string",
          "description": "10-digit Indian phone number",
          "pattern": "^[6-9][0-9]{9}$"
        },
        "city": {
          "type": "string",
          "description": "City name"
        },
        "area": {
          "type": "string",
          "description": "Area or Mohalla name"
        },
        "description": {
          "type": "string",
          "description": "Work summary and experience details"
        },
        "photoBase64": {
          "type": "string",
          "description": "Client-compressed base64 JPEG photo of worker"
        },
        "status": {
          "type": "string",
          "description": "Approval status",
          "enum": ["pending", "approved", "blocked"]
        },
        "spamCount": {
          "type": "number",
          "description": "Number of customer spam/dalal reports"
        },
        "reports": {
          "type": "array",
          "description": "List of complaint logs with reason and description"
        },
        "verified": {
          "type": "boolean",
          "description": "Whether the worker identity is verified by Admin / WhatsApp"
        },
        "rating": {
          "type": "number",
          "description": "Worker average rating out of 5"
        },
        "reviewsCount": {
          "type": "number",
          "description": "Number of completed ratings/reviews"
        },
        "availableToday": {
          "type": "boolean",
          "description": "Whether worker is ready for work today"
        },
        "skills": {
          "type": "array",
          "description": "List of specific skill tags"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["name", "category", "dailyRate", "experienceYears", "phone", "city", "area", "description", "status"]
    }
  },
  "firestore": {
    "/workers/{workerId}": {
      "schema": {
        "$ref": "#/entities/Worker"
      },
      "description": "Public directory of registered blue collar workers"
    }
  }
}
